# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Email that should receive project enquiries
CONTACT_TO_EMAIL=you@example.com

# Use a verified domain in production, e.g. CodeBheem <hello@yourdomain.com>
# For Resend testing you can temporarily use onboarding@resend.dev where permitted.
RESEND_FROM_EMAIL=CodeBheem <hello@yourdomain.com>

# Optional but recommended for canonical metadata/sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.com
